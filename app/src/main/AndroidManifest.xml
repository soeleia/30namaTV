<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Continue Watching on the launcher's Play Next row (WatchNext.kt). TvProvider guards all
         writes with it and grants no exception for watch_next_program, unlike channels; it is a
         normal permission, so declaring it is enough. -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- A remote or keyboard connecting must not restart a screen (and with it, playback). -->
    <application
        android:name=".App"
        android:banner="@drawable/nama_tv_banner"
        android:icon="@mipmap/ic_nama"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.App">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:theme="@style/Theme.App.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".LoginActivity" android:configChanges="keyboard|keyboardHidden|navigation" />
        <activity android:name=".DetailsActivity" android:configChanges="keyboard|keyboardHidden|navigation" />
        <activity
            android:name=".SearchActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:theme="@style/Theme.App.Search" />
        <activity
            android:name=".GridActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:theme="@style/Theme.App.Grid" />
        <activity android:name=".SettingsActivity" android:configChanges="keyboard|keyboardHidden|navigation" />
        <activity
            android:name=".PersonActivity"
            android:configChanges="keyboard|keyboardHidden|navigation" />
        <activity android:name=".PlayerActivity" android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation" />
        <activity android:name=".TrailerActivity" android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation" />
    </application>

    <!-- The YouTube apps a trailer can be handed to (Trailer.kt): SmartTube's three package names,
         YouTube for Android TV, and the phone app some boxes carry. Android 11 hides them otherwise. -->
    <queries>
        <package android:name="com.teamsmart.videomanager.tv" />
        <package android:name="com.liskovsoft.smarttubetv.beta" />
        <package android:name="com.liskovsoft.smarttubetv" />
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.google.android.youtube" />
    </queries>
</manifest>
