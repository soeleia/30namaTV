<?xml version="1.0" encoding="utf-8"?>
<!-- The promoted hero's controls under the billboard's words (see Promo.kt): one button to the
     title's page, and beside it, on the axis left and right page along, the page dots, the
     current page a white pill gliding over the dim ones. Anchored to the foot so the button
     never moves as the words above it change. Nothing here clips, so the focused button's lift
     draws whole past the row's edge (Promo unclips its root too). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|start"
    android:layout_marginStart="@dimen/content_start"
    android:layout_marginBottom="@dimen/promo_hero_bottom"
    android:clipChildren="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <Button
        android:id="@+id/promo_more"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/promo_info"
        android:text="@string/promo_more" />

    <!-- 20dp clear of the lifted pill. -->
    <FrameLayout
        android:id="@+id/promo_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:importantForAccessibility="noHideDescendants">

        <LinearLayout
            android:id="@+id/promo_track"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <View
            android:id="@+id/promo_dot"
            android:layout_width="@dimen/promo_dot_slot"
            android:layout_height="@dimen/promo_dot"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/promo_dot_on" />
    </FrameLayout>
</LinearLayout>
