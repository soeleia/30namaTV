<?xml version="1.0" encoding="utf-8"?>
<!-- The promoted hero's controls under the billboard's words (see Promo.kt): Play and More,
     then the page dots, the current page a white pill gliding over the dim ones. Anchored to
     the foot so the buttons never move as the words above them change. Nothing here clips, so
     the focused button's lift draws whole past the row's edge (Promo unclips its root too). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|start"
    android:layout_marginStart="@dimen/content_start"
    android:layout_marginBottom="@dimen/promo_hero_bottom"
    android:clipChildren="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:orientation="horizontal">

        <Button
            android:id="@+id/promo_watch"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/act_play" />

        <Button
            android:id="@+id/promo_more"
            style="@style/Widget.App.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/button_gap"
            android:drawableStart="@drawable/promo_info"
            android:text="@string/promo_more" />
    </LinearLayout>

    <!-- 18dp under the pill, which sits 2dp inside its button. -->
    <FrameLayout
        android:id="@+id/promo_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:importantForAccessibility="noHideDescendants">

        <LinearLayout
            android:id="@+id/promo_track"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <View
            android:id="@+id/promo_dot"
            android:layout_width="@dimen/promo_dot_slot"
            android:layout_height="@dimen/promo_dot"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/promo_dot_on" />
    </FrameLayout>
</LinearLayout>
