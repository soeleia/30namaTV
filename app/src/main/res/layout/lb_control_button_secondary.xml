<?xml version="1.0" encoding="utf-8"?>
<!-- The player's own buttons (audio and subtitles, quality, speed, episodes), as the play
     cluster's (lb_control_button_primary): white disc and ink glyph under the remote. Their
     player_* glyphs are drawn on a 24dp grid and show at that size. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/button"
    style="?attr/playbackControlsButtonStyle"
    android:layout_width="@dimen/button_target"
    android:layout_height="@dimen/button_target"
    android:background="@drawable/trailer_button"
    android:stateListAnimator="@animator/button_lift">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:duplicateParentState="true"
        android:tint="@color/on_button" />
</FrameLayout>
