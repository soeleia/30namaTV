<?xml version="1.0" encoding="utf-8"?>
<!-- A top-level page (home, a catalogue grid, search) in R.id.browse_host, and over its start
     edge the navigation rail (see Rail.kt). Shut, the rail is its icons on a column of solid ink
     that feathers into the page, the page you are on marked in red. Open, a panel (solid under
     the labels, feathering past them) slides in from the edge, the labels follow, a
     scrim dims the page, and one white pill glides between the items. Nothing underneath moves,
     and nothing here changes size: only alpha and transforms animate. -->
<androidx.leanback.widget.BrowseFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/browse_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/rail_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@android:color/black" />

    <FrameLayout
        android:id="@+id/rail"
        android:layout_width="@dimen/rail_panel_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:descendantFocusability="blocksDescendants">

        <View
            android:id="@+id/rail_shade"
            android:layout_width="@dimen/content_start"
            android:layout_height="match_parent"
            android:layout_gravity="start" />

        <View
            android:id="@+id/rail_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0" />

        <!-- The original compact 30nama mark, centred over the icons. -->
        <ImageView
            android:id="@+id/rail_brand"
            android:layout_width="@dimen/rail_width"
            android:layout_height="@dimen/rail_brand_size"
            android:layout_gravity="top|start"
            android:layout_marginTop="@dimen/rail_brand_top"
            android:contentDescription="@string/app_name"
            android:scaleType="centerInside"
            android:src="@drawable/nama_logo_compact" />

        <!-- The page you are on: a short red bar at the very edge, beside its icon. -->
        <View
            android:id="@+id/rail_mark"
            android:layout_width="@dimen/rail_mark_width"
            android:layout_height="@dimen/rail_mark_height"
            android:layout_gravity="top|start"
            android:background="@drawable/rail_mark" />

        <!-- The one focus pill, created once; it glides to whichever item has focus. -->
        <View
            android:id="@+id/rail_pill"
            android:layout_width="@dimen/rail_pill_width"
            android:layout_height="@dimen/rail_item_height"
            android:layout_gravity="top|start"
            android:layout_marginStart="@dimen/rail_item_inset"
            android:alpha="0"
            android:background="@drawable/rail_pill" />

        <!-- A fixed distance under the mark rather than centred, so the two stay one group
             whatever the screen's height or the number of items. -->
        <LinearLayout
            android:id="@+id/rail_items"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginTop="@dimen/rail_items_top"
            android:orientation="vertical" />
    </FrameLayout>
</androidx.leanback.widget.BrowseFrameLayout>
