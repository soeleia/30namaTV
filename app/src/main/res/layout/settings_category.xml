<?xml version="1.0" encoding="utf-8"?>
<!-- One section, its icon then its name: the rail's pill and face, white with ink under the
     remote, and while the remote is in its options a filled grey pill, so the panel beside it
     always shows whose options they are. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/rail_item_height"
    android:layout_marginBottom="@dimen/rail_item_gap"
    android:background="@drawable/settings_category"
    android:drawablePadding="12dp"
    android:drawableTint="@color/settings_category_ink"
    android:ellipsize="end"
    android:focusable="true"
    android:gravity="center_vertical|start"
    android:maxLines="1"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:textAlignment="viewStart"
    android:textAppearance="@style/TextAppearance.App.Nav"
    android:textColor="@color/settings_category_ink" />
