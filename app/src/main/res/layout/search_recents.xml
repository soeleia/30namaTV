<?xml version="1.0" encoding="utf-8"?>
<!-- Search's recent searches, over the suggestions while the box is empty (SearchFragment.showRecents):
     a row title, then a strip of pills that moves as a row of posters does. Out of its first pill
     toward the start edge the remote goes on into the rail (focusOutFront), as from a row's first card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:lb="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/content_start"
        android:paddingEnd="@dimen/content_start"
        android:text="@string/search_recent"
        android:textAlignment="viewStart"
        android:textAppearance="@style/TextAppearance.Leanback.Header" />

    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/search_recent_strip"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_target"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="20dp"
        android:clipToPadding="false"
        android:horizontalSpacing="@dimen/button_gap"
        android:paddingStart="@dimen/content_start"
        android:paddingEnd="@dimen/content_start"
        lb:focusOutFront="true" />
</LinearLayout>
