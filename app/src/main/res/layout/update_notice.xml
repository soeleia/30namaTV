<?xml version="1.0" encoding="utf-8"?>
<!-- A new release is ready (UpdateNotice.kt): one pill in home's top end corner, its centre level
     with the rail's brand mark across the screen (40 + 40 / 2 = 60dp down), 48dp in from the
     safe edge. The red status light, what is ready, a hairline, then what OK does. One target:
     OK installs, Back puts it away, Down returns to the hero or the rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/update_notice"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/button_target"
    android:layout_gravity="top|end"
    android:layout_marginTop="36dp"
    android:layout_marginEnd="48dp"
    android:background="@drawable/update_notice"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/button_pad_icon"
    android:paddingEnd="@dimen/button_pad"
    android:stateListAnimator="@animator/button_lift"
    android:visibility="gone">

    <View
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/update_dot"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/update_notice_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.App.Button" />

    <View
        android:layout_width="1dp"
        android:layout_height="20dp"
        android:layout_marginStart="14dp"
        android:background="@drawable/update_rule"
        android:duplicateParentState="true"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/update_notice_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:text="@string/update_install"
        android:textAppearance="@style/TextAppearance.App.Button" />
</LinearLayout>
