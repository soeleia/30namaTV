<?xml version="1.0" encoding="utf-8"?>
<!-- An empty list, in the middle of where its grid would be: what is (not) here, how titles get
     here, and one button to the suggested archive. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/list_empty"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lists_empty_title"
        android:textAppearance="@style/TextAppearance.App.DialogTitle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxWidth="420dp"
        android:gravity="center"
        android:text="@string/lists_empty_hint"
        android:textAppearance="@style/TextAppearance.App.Body"
        android:textColor="@color/text_dim" />

    <Button
        android:id="@+id/list_empty_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/suggested_archive" />
</LinearLayout>
