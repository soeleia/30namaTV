<?xml version="1.0" encoding="utf-8"?>
<!-- Leanback's player row under its own name (PlaybackTransportRowPresenter finds each part by its
     id). Above the bar only the title: its poster beside its names and facts, their foot level with
     the poster's. Under the bar, the clock beneath its two ends, elapsed at the left and the length
     at the right in either language as the bar fills, when it ends beside the length, and under the
     clock every button in one row, YouTube's: the play cluster from the bar's left end, where
     playback starts, the panels' buttons to its right end. Leanback's "/" between the times is gone
     with them apart; the thumbnails are Leanback's as they were. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/lb_playback_transport_control_row_padding_bottom">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/controls_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:clipToPadding="false"
            android:paddingStart="?attr/browsePaddingStart"
            android:paddingEnd="?attr/browsePaddingEnd"
            android:layout_marginBottom="@dimen/lb_playback_transport_control_info_margin_bottom"
            android:orientation="horizontal">

            <!-- The title's poster (Glue's art), rounded as the posters are everywhere else. -->
            <ImageView
                android:id="@+id/image"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/player_poster_height"
                android:layout_gravity="bottom"
                android:adjustViewBounds="true"
                android:layout_marginEnd="@dimen/lb_playback_transport_image_margin_end"
                android:background="@drawable/player_poster"
                android:clipToOutline="true"
                android:importantForAccessibility="no"
                android:scaleType="fitStart" />

            <FrameLayout
                android:id="@+id/description_dock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:clipToPadding="false"
                android:gravity="bottom" />
        </LinearLayout>
        <androidx.leanback.widget.ThumbsBar
            android:id="@+id/thumbs_row"
            android:orientation="horizontal"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="@dimen/lb_playback_transport_thumbs_bottom_margin" />
    </FrameLayout>

    <androidx.leanback.widget.PlaybackTransportRowView
        android:id="@+id/transport_row"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="?attr/browsePaddingStart"
        android:paddingEnd="?attr/browsePaddingEnd"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.leanback.widget.SeekBar
            android:id="@+id/playback_progress"
            android:layout_width="match_parent"
            android:layout_height="@dimen/lb_playback_transport_progressbar_height"
            android:focusable="true" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr">

            <TextView
                android:id="@+id/current_time"
                style="?attr/playbackControlsTimeStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start" />

            <!-- The end, then the length: both the timeline's, so they share its end. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/player_ends"
                    style="?attr/playbackControlsTimeStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp" />

                <TextView
                    android:id="@+id/total_time"
                    style="?attr/playbackControlsTimeStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </FrameLayout>

        <!-- One child of the row, so Left and Right cross from the play cluster to the panels'
             buttons (PlaybackTransportRowView keeps them inside the focused child) and Up from
             either reaches the bar. Left to right in either language, as the bar and the clock
             are. A glyph's ink sits 16dp inside a play button (Leanback's 32dp box in a 48dp target,
             its ink a quarter in) and 12dp inside a panel's, so the margins line both up with the
             bar's ends. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipChildren="false"
            android:layoutDirection="ltr">

            <FrameLayout
                android:id="@+id/controls_dock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_marginLeft="-16dp"
                android:clipChildren="false" />

            <FrameLayout
                android:id="@+id/secondary_controls_dock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_marginRight="-12dp"
                android:clipChildren="false"
                android:layoutDirection="locale" />
        </FrameLayout>
    </androidx.leanback.widget.PlaybackTransportRowView>
</LinearLayout>
