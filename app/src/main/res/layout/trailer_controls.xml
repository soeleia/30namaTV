<?xml version="1.0" encoding="utf-8"?>
<!-- A trailer's controls, the full player's in brief: back 10 s, play / pause and on 10 s centred
     over the bar, the bar in the player's red, loaded and track tones, the clock beneath its two
     ends. Left to right in either language, as the bar fills (PlayerActivity's transport); the
     clock takes the app's digits from the locale. media3's control view finds each part by its
     exo_ id; the cluster is its "center controls", the one block it fades in and out, scrim and
     all (dimens_trailer.xml keeps the bar from sliding on its own). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@id/exo_center_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/trailer_scrim"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layoutDirection="ltr"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="96dp"
        android:paddingEnd="56dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:clipChildren="false"
            android:orientation="horizontal">

            <ImageButton
                android:id="@id/exo_rew"
                style="@style/Widget.App.Transport" />

            <ImageButton
                android:id="@id/exo_play_pause"
                style="@style/Widget.App.Transport"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp" />

            <ImageButton
                android:id="@id/exo_ffwd"
                style="@style/Widget.App.Transport" />
        </LinearLayout>

        <!-- The knob shows only under the remote (white is focus). The bar is drawn inset by the
             knob's radius, so -8dp lines its ends up with the clock's. -->
        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginStart="-8dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="-8dp"
            app:bar_height="4dp"
            app:buffered_color="@color/progress_loaded"
            app:played_color="@color/red"
            app:scrubber_color="@color/text"
            app:scrubber_dragged_size="16dp"
            app:scrubber_enabled_size="0dp"
            app:touch_target_height="24dp"
            app:unplayed_color="@color/text_faint" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.App.Caption" />
        </FrameLayout>
    </LinearLayout>
</merge>
