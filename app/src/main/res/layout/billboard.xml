<?xml version="1.0" encoding="utf-8"?>
<!-- Netflix's billboard: the focused title's art fills the screen behind the rows, darkened
     toward the text side and the foot, with its names, meta line and synopsis on top. The words
     sit on the foot of their block, which ends at 229dp (30 + 199), a row title's height above
     @dimen/billboard_height where the rows begin: a short synopsis or a missing Persian name
     leaves the space above the name, not a band of bare art over the rows. The block's 199dp
     holds the most a row's card can bring (a two-line name, its Persian name, the meta line and
     two synopsis lines); the hero's three lines grow it, and Promo lifts it clear of its buttons. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <!-- promo_drift wider than the screen each side: the hero's page turn drifts it that far. -->
    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="-16dp"
        android:layout_marginEnd="-16dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- The art a hero page turn leaves behind, drifting off over the new art as it fades
         (Billboard.turn). Empty the rest of the time, so it draws nothing. -->
    <ImageView
        android:id="@+id/backdrop_leaving"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="-16dp"
        android:layout_marginEnd="-16dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/scrim_side"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/scrim_bottom"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/billboard"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/content_start"
        android:layout_marginTop="30dp"
        android:gravity="bottom"
        android:minHeight="199dp"
        android:orientation="vertical">

        <include layout="@layout/billboard_names" />

        <TextView
            android:id="@+id/bb_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.Meta" />

        <TextView
            android:id="@+id/bb_plot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.App.Synopsis" />
    </LinearLayout>
</FrameLayout>
