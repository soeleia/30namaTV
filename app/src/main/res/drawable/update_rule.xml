<?xml version="1.0" encoding="utf-8"?>
<!-- The hairline between the notice's words and its action: 20% white on the glass, 20% ink on the white. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><color android:color="#33141414" /></item>
    <item android:state_pressed="true"><color android:color="#33141414" /></item>
    <item><color android:color="@color/focus_wash" /></item>
</selector>
