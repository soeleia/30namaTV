<?xml version="1.0" encoding="utf-8"?>
<!-- Home's update notice (UpdateNotice.kt): the skip pill's dark glass, so it reads over any art
     in the corner it sits in, with a 20% white hairline in place of the skip pill's white rim (a
     white rim at rest would read as focus here, among home's other controls). Solid white under the
     remote, with a 12% ink hairline so it keeps its edge over white art, a shade down while OK is
     held, the fill fading as every control's does. Inset 2dp
     top and bottom, as button.xml: a 44dp pill in the 48dp target. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="@dimen/button_inset" android:insetBottom="@dimen/button_inset">
    <selector android:enterFadeDuration="150" android:exitFadeDuration="100">
        <item android:state_pressed="true">
            <shape><solid android:color="@color/text_body" /><stroke android:width="1dp" android:color="#1F141414" /><corners android:radius="@dimen/button_radius" /></shape>
        </item>
        <item android:state_focused="true">
            <shape><solid android:color="@color/text" /><stroke android:width="1dp" android:color="#1F141414" /><corners android:radius="@dimen/button_radius" /></shape>
        </item>
        <item>
            <shape>
                <solid android:color="@color/notice_glass" />
                <stroke android:width="1dp" android:color="@color/focus_wash" />
                <corners android:radius="@dimen/button_radius" />
            </shape>
        </item>
    </selector>
</inset>
