<?xml version="1.0" encoding="utf-8"?>
<!-- A transport button, the trailer's and the full player's (lb_control_button_*): the bare glyph
     over the scrim at rest, and under the remote the round button's white 44dp disc (button.xml)
     with the glyph in ink, a shade down while OK is held. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="@dimen/button_inset">
    <selector android:enterFadeDuration="150" android:exitFadeDuration="100">
        <item android:state_pressed="true">
            <shape android:shape="oval"><solid android:color="@color/text_body" /></shape>
        </item>
        <item android:state_focused="true">
            <shape android:shape="oval"><solid android:color="@color/text" /></shape>
        </item>
    </selector>
</inset>
