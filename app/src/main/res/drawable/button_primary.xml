<?xml version="1.0" encoding="utf-8"?>
<!-- Play / Resume: as button.xml, a step brighter at rest so the main action leads the row even
     while the remote is elsewhere in it. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="@dimen/button_inset" android:insetBottom="@dimen/button_inset">
    <selector android:enterFadeDuration="150" android:exitFadeDuration="100">
        <item android:state_enabled="false">
            <shape><solid android:color="@color/button_disabled" /><corners android:radius="@dimen/button_radius" /></shape>
        </item>
        <item android:state_pressed="true">
            <shape><solid android:color="@color/text_body" /><corners android:radius="@dimen/button_radius" /></shape>
        </item>
        <item android:state_focused="true">
            <shape><solid android:color="@color/text" /><corners android:radius="@dimen/button_radius" /></shape>
        </item>
        <item>
            <shape><solid android:color="@color/button_primary" /><corners android:radius="@dimen/button_radius" /></shape>
        </item>
    </selector>
</inset>
