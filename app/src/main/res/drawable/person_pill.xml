<?xml version="1.0" encoding="utf-8"?>
<!-- One of the sort pair, inside its track (person_sort_track): the app's primary pill fill on
     the order in use, so it stands clear of the track, bare on the other, solid white under the
     remote. Same inset, corners and fades as every button. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="@dimen/button_inset" android:insetBottom="@dimen/button_inset">
    <selector android:enterFadeDuration="150" android:exitFadeDuration="100">
        <item android:state_pressed="true">
            <shape><solid android:color="@color/text_body" /><corners android:radius="@dimen/button_radius" /></shape>
        </item>
        <item android:state_focused="true">
            <shape><solid android:color="@color/text" /><corners android:radius="@dimen/button_radius" /></shape>
        </item>
        <item android:state_selected="true">
            <shape><solid android:color="@color/button_primary" /><corners android:radius="@dimen/button_radius" /></shape>
        </item>
        <item>
            <shape><solid android:color="@android:color/transparent" /><corners android:radius="@dimen/button_radius" /></shape>
        </item>
    </selector>
</inset>
