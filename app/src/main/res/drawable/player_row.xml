<?xml version="1.0" encoding="utf-8"?>
<!-- A player panel row or season chip: the rail's white pill under the focused one, fading in over
     150 ms and out over 100 ms as the remote moves. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="150" android:exitFadeDuration="100">
    <item android:state_focused="true" android:drawable="@drawable/rail_pill" />
    <item android:drawable="@android:color/transparent" />
</selector>
