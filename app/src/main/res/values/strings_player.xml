<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="fa">
    <string name="player_speed">سرعت پخش</string>
    <!-- In step with PlayerFragment.SPEEDS. -->
    <string-array name="player_speeds">
        <item>۰٫۵×</item>
        <item>۰٫۷۵×</item>
        <item>عادی</item>
        <item>۱٫۲۵×</item>
        <item>۱٫۵×</item>
        <item>۲×</item>
    </string-array>

    <!-- The settings panel's pages and columns. -->
    <string name="player_audio_subtitles">صدا و زیرنویس</string>
    <string name="player_quality_speed">کیفیت و سرعت</string>
    <!-- The appearance page's live preview, drawn as the subtitles are. -->
    <string name="player_sample">زیرنویس این‌طور دیده می‌شود</string>
    <!-- An audio track with neither a name nor a language. -->
    <string name="player_track">صدای %d</string>
    <!-- The skip pill over the video: the recap's label, short beside «رد تیتراژ». -->
    <string name="player_skip_recap">رد خلاصه</string>
    <!-- The same pill for a title picked up part-way, its first seconds: back to the start. -->
    <string name="player_start_over">پخش از ابتدا</string>

    <!-- Playback stopped (PlayerFragment.errorMessage): what went wrong and what to do. Play
         («پخش», the transport's button) retries. -->
    <string name="player_error_network">اتصال اینترنت قطع شد. پس از وصل شدن، دوباره پخش را بزنید.</string>
    <string name="player_error_server">این ویدیو فعلاً در دسترس نیست. کمی بعد دوباره پخش را بزنید.</string>
    <string name="player_error_format">این فایل روی این تلویزیون پخش نمی‌شود. کیفیت دیگری را امتحان کنید.</string>
    <string name="player_error">پخش متوقف شد. دوباره پخش را بزنید.</string>

    <!-- Find subtitles (Subtitles.kt): the Subtitles column's entry and the page it opens, which
         searches SubDL and OpenSubtitles for what plays. Site names stay Latin and never open a
         line: a line that starts with a Latin word turns left to right. -->
    <string name="subtitle_find">یافتن زیرنویس</string>
    <string name="subtitle_searching">در حال جست‌وجوی زیرنویس…</string>
    <string name="subtitle_none_film">زیرنویسی برای این فیلم پیدا نشد.</string>
    <string name="subtitle_none_episode">زیرنویسی برای این قسمت پیدا نشد.</string>
    <string name="subtitle_search_again">جست‌وجوی دوباره</string>
    <!-- On the chosen result's row, in place of its source, while it downloads. -->
    <string name="subtitle_downloading">در حال دانلود…</string>
    <!-- A downloaded one in the Subtitles column: its language and the site it came from, «فارسی از SubDL». -->
    <string name="subtitle_found">%1$s از %2$s</string>
    <!-- How often a result was downloaded, %s already grouped in Persian digits («۱۲٬۳۴۵ دانلود»). -->
    <plurals name="subtitle_downloads">
        <item quantity="one">%s دانلود</item>
        <item quantity="other">%s دانلود</item>
    </plurals>
    <string name="subtitle_hearing_impaired">ویژهٔ ناشنوایان</string>
    <!-- Failures, on the page or on a result's row; %s is the site. The quota is a site's daily
         allowance (OpenSubtitles: five downloads a day without an account). -->
    <string name="subtitle_error_network">ارتباط با سایت‌های زیرنویس برقرار نشد. اتصال اینترنت را بررسی کنید.</string>
    <string name="subtitle_error_down">سایت %s فعلاً پاسخ نمی‌دهد. کمی بعد دوباره امتحان کنید.</string>
    <string name="subtitle_error_quota">سهمیهٔ امروز %s تمام شده است. زیرنویس دیگری را امتحان کنید.</string>
    <string name="subtitle_error_file">این زیرنویس باز نشد. یکی دیگر را امتحان کنید.</string>

    <!-- Make Persian subtitles (Translator.kt): the Subtitles column's entry, which has a model
         translate an English subtitle, and the page that shows how far it has got. %s is the
         model's name (Gemini, Claude, OpenAI), Latin, so it never opens a line. -->
    <string name="subtitle_translate">ساخت زیرنویس فارسی</string>
    <string name="subtitle_translate_by">ترجمه با %s</string>
    <string name="subtitle_translate_finding">در حال یافتن زیرنویس انگلیسی…</string>
    <!-- %s is the share done, already in Persian digits. -->
    <string name="subtitle_translating">در حال ترجمه… %s٪</string>
    <!-- Under the page's note, the row that closes the panel, and its quiet line. -->
    <string name="subtitle_translate_watch">ادامهٔ تماشا</string>
    <string name="subtitle_translate_wait">چند دقیقه طول می‌کشد؛ آماده که شد، خودش نمایش داده می‌شود.</string>
    <string name="subtitle_translated">زیرنویس فارسی آماده شد.</string>
    <string name="subtitle_translate_again">تلاش دوباره</string>
    <string name="subtitle_translate_none">زیرنویس انگلیسی‌ای برای ترجمه پیدا نشد.</string>
    <string name="subtitle_translate_key">کلید %s پذیرفته نشد. آن را در تنظیمات، بخش سرویس‌ها بررسی کنید.</string>
    <string name="subtitle_translate_quota">سهمیه یا اعتبار حساب %s تمام شده است.</string>
    <string name="subtitle_translate_region">سرویس %s از این منطقه در دسترس نیست. با VPN دوباره امتحان کنید.</string>
    <string name="subtitle_translate_blocked">سرویس %s ترجمهٔ این زیرنویس را نپذیرفت. با کلید سرویس دیگری امتحان کنید.</string>
    <string name="subtitle_translate_down">سرویس %s فعلاً پاسخ نمی‌دهد. کمی بعد دوباره امتحان کنید.</string>
    <string name="subtitle_translate_network">ارتباط با %s برقرار نشد. اتصال اینترنت را بررسی کنید.</string>

    <!-- Subtitle timing: the Subtitles column's entry, under it what it is set to, and the page it
         opens, whose rows move the shown subtitle a quarter second a press. %s is the seconds,
         already in Persian digits («۰٫۲۵»). -->
    <string name="subtitle_timing">زمان‌بندی زیرنویس</string>
    <string name="subtitle_timing_none">بدون جابه‌جایی</string>
    <string name="subtitle_timing_earlier">%s ثانیه زودتر</string>
    <string name="subtitle_timing_later">%s ثانیه دیرتر</string>
    <string name="subtitle_earlier">زودتر</string>
    <string name="subtitle_earlier_hint">وقتی زیرنویس از صدا عقب است</string>
    <string name="subtitle_later">دیرتر</string>
    <string name="subtitle_later_hint">وقتی زیرنویس از صدا جلو است</string>
    <string name="subtitle_timing_error">این زیرنویس جابه‌جا نشد. دوباره امتحان کنید.</string>
</resources>
