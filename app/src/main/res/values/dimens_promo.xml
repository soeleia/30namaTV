<?xml version="1.0" encoding="utf-8"?>
<!-- Home's promoted hero (Promo.kt) on the 540dp screen. While it is up the rows sit
     promo_rows_drop lower, their first title at 424dp, so its posters peek in under the hero.
     Above that, from the foot up: the page dots end 22dp over the row title (402dp), the
     buttons sit 18dp over the dots (330 to 378dp), and the billboard's words end 20dp over the
     buttons (310dp) and grow upward: names, meta and three lines of synopsis
     (50 + 34 + 35 + 100 dp at most) start no higher than 91dp. -->
<resources>
    <dimen name="promo_rows_drop">172dp</dimen>
    <dimen name="promo_hero_bottom">138dp</dimen>
    <dimen name="promo_text_bottom">230dp</dimen>
    <dimen name="promo_dot">6dp</dimen>
    <!-- Each dot's slot, as wide as the current page's pill. -->
    <dimen name="promo_dot_slot">18dp</dimen>
</resources>
