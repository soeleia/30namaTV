<?xml version="1.0" encoding="utf-8"?>
<!-- A player panel row's text and icon: ink on the white pill, white for the current choice, the
     rest a step back so the current one reads at a glance. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/ink" android:state_focused="true" />
    <item android:color="@color/text" android:state_selected="true" />
    <item android:color="@color/text_dim" />
</selector>
