<?xml version="1.0" encoding="utf-8"?>
<!-- The one folder the installer is handed a file from: the verified copy in internal storage
     (AppUpdates.updateFile). Not the download's folder on shared storage, which other apps could write to
     up to Android 10; Android 6 installs from there by file://, without this provider. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="updates" path="updates/" />
</paths>
