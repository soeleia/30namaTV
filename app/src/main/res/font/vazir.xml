<?xml version="1.0" encoding="utf-8"?>
<!-- Body text: Yekan Bakh (Reza Bakhtiarifard, commercial), its Fa-En cut: Latin digits stay Latin
     (localDigits() makes them Persian in Persian mode), and its Latin letters (from Lato) cover
     stray English the Inter spans miss. It replaced Vazirmatn without touching callers:
     vazirmatn_regular/medium/bold are now one-font families pointing here, so @font/vazirmatn_*
     and R.font.vazirmatn_* all draw Yekan Bakh. Rename them body_* once nothing else is in flight. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:font="@font/yekanbakh_regular" android:fontStyle="normal" android:fontWeight="400"
        app:font="@font/yekanbakh_regular" app:fontStyle="normal" app:fontWeight="400" />
    <font android:font="@font/yekanbakh_regular" android:fontStyle="normal" android:fontWeight="500"
        app:font="@font/yekanbakh_regular" app:fontStyle="normal" app:fontWeight="500" />
    <font android:font="@font/yekanbakh_bold" android:fontStyle="normal" android:fontWeight="700"
        app:font="@font/yekanbakh_bold" app:fontStyle="normal" app:fontWeight="700" />
</font-family>
